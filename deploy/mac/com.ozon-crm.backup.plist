       Аудит: основная машина с данными не имела расписания бэкапов. -->
  <key>Label</key><string>com.ozon-crm.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/maxim/Documents/разработки123/parser_ozon/repo/.venv/bin/python</string>
    <string>tools/backup_db.py</string>
    <string>--push</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/maxim/Documents/разработки123/parser_ozon/repo</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/maxim/Documents/разработки123/parser_ozon/repo/logs/backup_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/maxim/Documents/разработки123/parser_ozon/repo/logs/backup_launchd.log</string>
</dict>
</plist>
